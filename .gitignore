# Track only the deployment files and README at the project root.
/*
!/.gitignore
!/README.md
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json
!/vite.config.ts
!/src/
!/.github/
!/scripts/
!/supabase/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

/scripts/*
!/scripts/admin-cleanup.mjs

/supabase/*
!/supabase/functions/
/supabase/functions/*
!/supabase/functions/tribute-api/
!/supabase/video-only-submissions.sql

# Local secrets, dependencies and generated output remain private.
node_modules
dist
.DS_Store
.env.local
.env.*.local

.cache/
.downloads/
.tools/
.env
.env.backend.local
supabase/.temp/
